  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/fonts": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/install-whisper-cpp": "4.0.544",
    "@remotion/layout-utils": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/media-utils": "4.0.544",
    "@remotion/noise": "4.0.544",
    "@remotion/sfx": "4.0.544",
    "@remotion/transitions": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.544",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "pngjs": "^7.0.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "sprites": "python3 scripts/sprite_builder/build_all.py && python3 scripts/sprite_builder/build_props.py && python3 scripts/make-grain.py",
    "sfx": "node scripts/synth-sfx.mjs && tsx scripts/gen-sfx.ts",
    "bgm": "node scripts/synth-bgm.mjs",
    "sync": "tsx scripts/probe-media.ts && tsx scripts/analyze-dub.ts && tsx scripts/validate.ts",
    "still": "remotion still LilinJelantah --frame=2100 out/still.png",
    "render:preview": "remotion render LilinJelantah out/preview.mp4 --scale=0.5 --crf=28",
    "render:final": "remotion render LilinJelantah out/lilin-jelantah-final.mp4 --codec=h264 --crf=16"
  },
  "allowScripts": {
    "esbuild": false
  }
}
